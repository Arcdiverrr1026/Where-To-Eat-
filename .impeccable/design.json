  "narrative": {
    "northStar": "Personal Address Book",
    "overview": "A private address book of meals: white reading surfaces, pale green navigation, compact ink typography, and deliberate green actions. The interface supports revisiting personal records rather than browsing a public ratings feed. Chinese copy is direct and restrained; the Where To Eat name and existing illustrated brand mark remain visible.\n\nThe built world uses ruled lists, adjacent detail reading, and quiet forms. Amber communicates personal ratings, violet identifies imported provenance, and coral marks favorites. Decoration does not replace restaurant names, experience text, or source attribution.",
    "keyCharacteristics": [
      "White reading surfaces and pale green navigation.",
      "Ruled records instead of floating content cards.",
      "Compact Chinese-first hierarchy with visible provenance.",
      "Explicit actions, readable feedback, and responsive task continuity."
    ],
    "rules": [
      {
        "name": "The Semantic Accent Rule",
        "body": "Keep green for actions and selection, amber for ratings, violet for provenance, and coral for row favorites; retain text or accessible names alongside meaning-bearing color.",
        "section": "colors"
      },
      {
        "name": "The Reading Hierarchy Rule",
        "body": "Keep restaurant names and experience text above metadata in emphasis, with zero letter spacing and wrapping for long content.",
        "section": "typography"
      },
      {
        "name": "The Record Continuity Rule",
        "body": "Preserve access to the full record across viewport changes; mobile uses a dedicated detail route instead of squeezing the desktop split view.",
        "section": "layout"
      },
      {
        "name": "The Ruled Surface Rule",
        "body": "Separate records and sections with rules or tonal state changes, not lifted content cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep private experience text and its source visually distinct from place data.",
      "Do reuse ruled rows, restrained controls, and the existing responsive navigation.",
      "Do keep placeholders at the muted token with full opacity and errors visible in the shared main-content alert.",
      "Do preserve reduced-motion behavior, keyboard focus, and accessible icon names."
    ],
    "donts": [
      "Don't turn the record library into a public popularity feed or promote imported text as the user's own experience.",
      "Don't replace flat reading sections with nested floating cards or oversized display headings.",
      "Don't present fallback restaurant states or supplied screenshots as verified live AMap service results.",
      "Don't treat synthesized sidecar ramps or one-off local values as new production token scales."
    ]
  }
}
